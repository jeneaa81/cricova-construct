# Telegram Bot Settings
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID чата менеджера или группы магазина для получения уведомлений о новых заявках
# (Если не указано, заявки будут логироваться в консоль и сохраняться в базу данных)
MANAGER_CHAT_ID=

# Google Gemini API Key (для распознавания фото техпаспортов через AI)
# Опционально. Если ключ не указан, работает встроенный эмулятор распознавания для демо
GEMINI_API_KEY=

# Режим отладки (True/False)
DEBUG=True
